{
  "name": "neighborhoodos",
  "version": "0.1.0",
  "description": "Community-governed civic AI for neighborhoods: Learn / Solve / Build education, provenance-first public data and memory, and local AI infrastructure.",
  "type": "module",
  "main": "core/node.js",
  "scripts": {
    "sync": "node ingest/sync.js",
    "sync:status": "node ingest/sync.js --status",
    "api": "node identity/api.js",
    "start": "node ingest/sync.js && node identity/api.js",
    "test": "node identity/smoke-test.js && node identity/federation-smoke.js",
    "config:example": "cp -n node.config.example.json node.config.json"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "better-sqlite3": "^12.9.0",
    "nodemailer": "^8.0.5",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "neighborhood",
    "civic-tech",
    "governance",
    "commons",
    "open-data",
    "community"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simonlpaige/neighborhoodos"
  },
  "homepage": "https://neighborhoodos.org",
  "bugs": {
    "url": "https://github.com/simonlpaige/neighborhoodos/issues"
  }
}
